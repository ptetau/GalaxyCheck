<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>GalaxyCheck</RootNamespace>
    <!-- Core/ is the framework-neutral part that each framework package compiles. -->
    <DefineConstants>$(DefineConstants);GALAXYCHECK_XUNIT2</DefineConstants>
    <GenerateDocumentationFile Condition="'$(Configuration)' == 'Release'">true</GenerateDocumentationFile>
    <PackageVersion Condition="'$(PackageVersion)' == ''">1.0.0-dev</PackageVersion>
    <NuspecFile>GalaxyCheck.Xunit.nuspec</NuspecFile>
    <NuspecProperties>PackageVersion=$(PackageVersion)</NuspecProperties>
    <NuspecBasePath></NuspecBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.extensibility.execution" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GalaxyCheck\GalaxyCheck.csproj" />
  </ItemGroup>

</Project>