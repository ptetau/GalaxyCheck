<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <id>GalaxyCheck.Xunit</id>
        <version>$PackageVersion$</version>
        <description>An xunit integration for the property-based testing library GalaxyCheck</description>
        <authors>nth-commit</authors>
        <repository type="git" url="https://github.com/nth-commit/GalaxyCheck" />
        <license type="expression">MIT</license>
        <tags>GalaxyCheck;Property-Based Testing;Test Framework;Xunit</tags>
        <dependencies>
            <group targetFramework="net10.0">
                <dependency id="xunit.extensibility.execution" version="2.9.3" exclude="Build,Analyzers" />
                <dependency id="GalaxyCheck" version="$PackageVersion$" exclude="Build,Analyzers" />
                <dependency id="GalaxyCheck.Xunit.CodeAnalysis" version="$PackageVersion$" />
            </group>
            <group targetFramework="net11.0">
                <dependency id="xunit.extensibility.execution" version="2.9.3" exclude="Build,Analyzers" />
                <dependency id="GalaxyCheck" version="$PackageVersion$" exclude="Build,Analyzers" />
                <dependency id="GalaxyCheck.Xunit.CodeAnalysis" version="$PackageVersion$" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="bin\Release\net10.0\GalaxyCheck.Xunit.dll" target="lib\net10.0" />
        <file src="bin\Release\net10.0\GalaxyCheck.Xunit.xml" target="lib\net10.0" />
        <file src="bin\Release\net10.0\GalaxyCheck.Xunit.pdb" target="lib\net10.0" />
        <file src="bin\Release\net11.0\GalaxyCheck.Xunit.dll" target="lib\net11.0" />
        <file src="bin\Release\net11.0\GalaxyCheck.Xunit.xml" target="lib\net11.0" />
        <file src="bin\Release\net11.0\GalaxyCheck.Xunit.pdb" target="lib\net11.0" />
        <file src="..\..\docs\llms.txt" target="" />
        <file src="..\build\GalaxyCheck.ProjectFolder.props" target="buildTransitive\GalaxyCheck.Xunit.props" />
    </files>
</package>