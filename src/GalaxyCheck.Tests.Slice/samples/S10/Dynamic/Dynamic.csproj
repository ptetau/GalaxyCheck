<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1013;xUnit1026;CS8981;IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test run writes the test class to this file: -p:ExtraCompile=<path> -->
    <Compile Include="$(ExtraCompile)" Condition="'$(ExtraCompile)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\GalaxyCheck.Xunit.V3\GalaxyCheck.Xunit.V3.csproj" />
    <ProjectReference Include="..\..\..\..\GalaxyCheck\GalaxyCheck.csproj" />
  </ItemGroup>

</Project>
