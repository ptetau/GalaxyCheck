<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>GalaxyCheck</RootNamespace>
    <IsPackable>true</IsPackable>
    <IsTestProject>false</IsTestProject>
    <PackageId>GalaxyCheck.Xunit.V3</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Keep the dependencies beside the assembly in bin, so that a tool can load the built assembly. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GalaxyCheck\GalaxyCheck.csproj" />
  </ItemGroup>

  <!-- The shared framework core: attributes, configuration, and the property, sample, and snapshot logic. -->
  <ItemGroup>
    <Compile Include="..\GalaxyCheck.Xunit\Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>

  <!-- The build file that records the folder of the test project for the failure memory. -->
  <ItemGroup>
    <None Include="..\build\GalaxyCheck.ProjectFolder.props" Pack="true" PackagePath="buildTransitive\$(PackageId).props" Visible="false" />
  </ItemGroup>

</Project>
